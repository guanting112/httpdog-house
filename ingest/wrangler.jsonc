// The receiving Worker: httpdog POSTs its alerts to <this Worker>/<INGEST_PATH>/alerts. Every other
// address answers "not found"; INGEST_PATH is in ../deploy.local.env, not here.
//
// Plain TypeScript with no framework; wrangler bundles src/index.ts as it is. It shares one D1
// database with the UI Worker (../wrangler.jsonc).
//
// This file is committed, so what is yours stays out of it: the database id and your hostnames go
// in ../deploy.local.env (see ../deploy.local.env.example). `make deploy-ingest`, run from the
// repository root, writes wrangler.deploy.json next to this file with them and deploys from that.
// The values below are examples; deploying refuses to go on if they are replaced here.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "httpdog-house-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "httpdog-house",
      // An example: the real id is DATABASE_ID in ../deploy.local.env
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],

  // The defaults. A deployment changes them with RETENTION_DAYS and MAX_SKEW_SECS in
  // ../deploy.local.env, not here
  "vars": {
    // How far X-Httpdog-Timestamp may be from this Worker's clock, in seconds
    "MAX_SKEW_SECS": "300",
    // Alerts older than this many days are deleted by the daily run below. "0" keeps them forever
    "RETENTION_DAYS": "365"
  },

  // Once a day: delete alerts past RETENTION_DAYS, expired sessions and old rejections
  "triggers": { "crons": ["17 3 * * *"] },

  // Keeps this Worker's logs (refusals it could not record, failures) in the Cloudflare dashboard
  "observability": { "enabled": true }

  // SECRETS_KEY is a secret, not a var: set it with `make secrets`.

  // No address here: a deployment is served from the hostname in INGEST_DOMAIN of
  // ../deploy.local.env, and from nowhere else. The generated config always gets:
  //
  // "routes": [{ "pattern": "<INGEST_DOMAIN>", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false
}
