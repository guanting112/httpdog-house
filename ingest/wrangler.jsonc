// The receiving Worker: httpdog POSTs its alerts to <this Worker>/alerts.
//
// Plain TypeScript with no framework; wrangler bundles src/index.ts as it is. It shares one D1
// database with the UI Worker (../wrangler.jsonc): `database_id` must be the same in both files.
//
// Deploy with `make deploy-ingest` from the repository root.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "httpdog-house-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "httpdog-house",
      // Replace with the id that `make db-create` prints. The same id goes in ../wrangler.jsonc
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],

  "vars": {
    // How far X-Httpdog-Timestamp may be from this Worker's clock, in seconds
    "MAX_SKEW_SECS": "300",
    // Alerts older than this many days are deleted by the daily run below. "0" keeps them forever
    "RETENTION_DAYS": "90"
  },

  // Once a day: delete alerts past RETENTION_DAYS, expired sessions and old rejections
  "triggers": { "crons": ["17 3 * * *"] },

  // Keeps this Worker's logs (refusals it could not record, failures) in the Cloudflare dashboard
  "observability": { "enabled": true }

  // SECRETS_KEY is a secret, not a var: set it with `make secrets`.

  // By default the Worker is served from httpdog-house-ingest.<your account>.workers.dev.
  // To give it a hostname of your own (the zone must be in the same Cloudflare account):
  //
  // "routes": [{ "pattern": "hook.example.com", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false
}
