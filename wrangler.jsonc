// The UI Worker: the pages (static files) and their API (server/), built by Nuxt.
//
// `nuxt build` merges this file with the two things Nitro decides (the entry file and the assets
// directory) into .output/server/wrangler.json; `wrangler deploy` then uses that. So set bindings
// here, and deploy with `make deploy-ui`, which builds first.
//
// This file is committed, so what is yours stays out of it: the database id and your two hostnames
// go in deploy.local.env (see deploy.local.env.example), and `make deploy-ui` puts them into the
// generated config. The values below are examples; deploying refuses to go on if they are
// replaced here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "httpdog-house-ui",
  "compatibility_date": "2026-11-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "httpdog-house",
      // An example: the real id is DATABASE_ID in deploy.local.env
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Every request comes to the Worker first, the files of public/ included: the door
  // (server/middleware/01.door.ts) answers "not found" to all of it until a browser has been to
  // the entry address. Two things make that so, and `make deploy-ui` refuses to upload without them:
  //   run_worker_first    here, or Cloudflare hands out the files on its own, to anyone
  //   a binding "FILES"   or Nitro does: its Worker entry gives a file to whoever asks as soon as
  //                       it finds a binding called ASSETS, before any middleware runs. Nitro writes
  //                       that name into the config it generates whatever is said here, so the
  //                       build renames it afterwards (`bun run build`, scripts/deploy-config.ts)
  "assets": { "run_worker_first": true },

  "vars": {
    // Where httpdog should POST: the address of the ingest Worker, ending in /alerts.
    // The keys page shows it in the lines to copy to a host. An example: a deployment gets
    // https://<INGEST_DOMAIN>/alerts, from deploy.local.env
    "INGEST_URL": "https://hook.example.com/alerts"
  },

  // Sign-in attempts allowed per address per minute (counted per Cloudflare location).
  // namespace_id is any number that no other rate limiter in the account uses (a deployment with
  // deploy.<name>.env gets one of its own)
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "7301", "simple": { "limit": 10, "period": 60 } }],

  // Keeps this Worker's logs (the audit lines of server/utils/http.ts, failures) in the Cloudflare dashboard
  "observability": { "enabled": true }

  // SECRETS_KEY is a secret, not a var: set it with `make secrets`.

  // No address here: a deployment is served from the hostname in UI_DOMAIN of deploy.local.env,
  // and from nowhere else. The generated config always gets:
  //
  // "routes": [{ "pattern": "<UI_DOMAIN>", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false
}
