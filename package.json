{
  "name": "httpdog-house",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev",
    "dev:ingest": "wrangler dev -c ingest/wrangler.jsonc --port 8788 --persist-to .wrangler/state",
    "build": "nuxt build && bun scripts/deploy-config.ts built",
    "preview": "wrangler dev",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p ingest/tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/ubuntu-mono": "^5.3.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/bun": "^1.4.4",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.163.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
