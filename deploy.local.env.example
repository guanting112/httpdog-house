# What is yours about a deployment. Copy this file to deploy.local.env (`make db-create` does it)
# and fill it in. deploy.local.env is not committed: the two wrangler.jsonc files keep their example
# values, and `make deploy` puts these into the configs it generates (scripts/deploy-config.ts).

# Only for a second deployment in the same Cloudflare account: a short name (a-z, 0-9, dash) added
# to the names of both Workers and the database, as in httpdog-house-ui-<suffix>. Give that
# deployment a file of its own, deploy.<suffix>.env, and name the file on every command:
#   make deploy DEPLOY_ENV=deploy.<suffix>.env
# Set it before `make db-create`, and do not change it afterwards: a new suffix is a new deployment
NAME_SUFFIX=

# The id `make db-create` prints. Both Workers use this one database
DATABASE_ID=

# Hostnames of your own, without https://. Each zone must be in the same Cloudflare account.
# Empty: the Worker is served from <its name>.<your account>.workers.dev
UI_DOMAIN=
INGEST_DOMAIN=

# Where httpdog should POST: the receiver's address, ending in /alerts. The keys page shows it in
# the lines to copy to a host. Empty with INGEST_DOMAIN set means https://<INGEST_DOMAIN>/alerts.
# On workers.dev it is https://httpdog-house-ingest.<your account>.workers.dev/alerts
# (httpdog-house-ingest-<suffix> with a NAME_SUFFIX)
INGEST_URL=
