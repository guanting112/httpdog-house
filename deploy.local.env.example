# What is yours about a deployment. `make setup` copies this file to deploy.local.env, and stops
# there the first time: the two hostnames below are yours to choose, and nothing is set up without
# them. deploy.local.env is not committed: the two wrangler.jsonc files keep their example values,
# and `make deploy` puts these into the configs it generates (scripts/deploy-config.ts).

# ---------------------------------------------------------------- required: fill these in first
#
# The two hostnames of the deployment, without https://. A deployment is always served from
# hostnames of your own, never from workers.dev.
#
#   UI_DOMAIN       where you sign in             for example alerts.example.com
#   INGEST_DOMAIN   where httpdog POSTs alerts    for example hook.example.com
#                   (the address to give a host is then https://<INGEST_DOMAIN>/alerts)
#
# Each is a name under a domain that is in the same Cloudflare account, and that has no DNS record
# yet: Cloudflare makes the record and the certificate when the Worker is uploaded.
#
# Certificates are logged in public, so a hostname is not a secret: anyone can come across it.
# A name that does not say what it is for gives less away.
UI_DOMAIN=
INGEST_DOMAIN=

# ---------------------------------------------------------------- filled in by `make setup`
#
# The id of the D1 database both Workers use. `make setup` creates the database and writes it here
DATABASE_ID=

# ---------------------------------------------------------------- optional
#
# Only for a second deployment in the same Cloudflare account: a short name (a-z, 0-9, dash) added
# to the names of both Workers and the database, as in httpdog-house-ui-<suffix>. Give that
# deployment a file of its own, deploy.<suffix>.env, with hostnames of its own, and name the file
# on every command:
#   make setup DEPLOY_ENV=deploy.<suffix>.env
# Set it before the first `make setup`, and do not change it afterwards: a new suffix is a new deployment
NAME_SUFFIX=

# Settings of the receiver. Empty means the default; after a change, `make deploy-ingest`.
#
# How many days an alert is kept. Older ones are deleted once a day. 0 keeps alerts forever.
# Default 365
RETENTION_DAYS=
# How far a request's timestamp may be from the receiver's clock, in seconds. A request outside it
# is refused as stale, so raise it only for hosts whose clocks cannot be kept right. Default 300
MAX_SKEW_SECS=
