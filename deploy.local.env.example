# What is yours about a deployment. `make setup` copies this file to deploy.local.env and fills in
# what it can; the rest is optional. deploy.local.env is not committed: the two wrangler.jsonc files
# keep their example values, and `make deploy` puts these into the configs it generates
# (scripts/deploy-config.ts).

# Only for a second deployment in the same Cloudflare account: a short name (a-z, 0-9, dash) added
# to the names of both Workers and the database, as in httpdog-house-ui-<suffix>. Give that
# deployment a file of its own, deploy.<suffix>.env, and name the file on every command:
#   make setup DEPLOY_ENV=deploy.<suffix>.env
# Set it before the first `make setup`, and do not change it afterwards: a new suffix is a new deployment
NAME_SUFFIX=

# The id of the D1 database both Workers use. `make setup` creates the database and fills this in
DATABASE_ID=

# Hostnames of your own, without https://. Each zone must be in the same Cloudflare account.
# Empty: the Worker is served from <its name>.<your account>.workers.dev
UI_DOMAIN=
INGEST_DOMAIN=

# Where httpdog should POST: the receiver's address, ending in /alerts. The keys page shows it in
# the lines to copy to a host. Empty with INGEST_DOMAIN set means https://<INGEST_DOMAIN>/alerts.
# `make setup` fills it in when the receiver is on workers.dev, where it is https://httpdog-house-ingest.<your account>.workers.dev/alerts
# (httpdog-house-ingest-<suffix> with a NAME_SUFFIX)
INGEST_URL=

# Settings of the receiver. Empty means the default; after a change, `make deploy-ingest`.
#
# How many days an alert is kept. Older ones are deleted once a day. 0 keeps alerts forever.
# Default 400
RETENTION_DAYS=
# How far a request's timestamp may be from the receiver's clock, in seconds. A request outside it
# is refused as stale, so raise it only for hosts whose clocks cannot be kept right. Default 300
MAX_SKEW_SECS=
